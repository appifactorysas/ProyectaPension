# Copia este archivo como .env y ajusta los valores.
# NO subas el .env a ningún repositorio ni lo incluyas en la imagen Docker.

# ── Entorno ────────────────────────────────────────────────────────────
# "local" = escucha solo en 127.0.0.1, sin contraseña, cookies sin HTTPS.
# "web"   = escucha en 0.0.0.0, exige APP_PASSWORD y cookies seguras.
ENTORNO=local

# ── Acceso ─────────────────────────────────────────────────────────────
# Recomendada cuando ENTORNO=web. Sin ella la app queda abierta sin
# contraseña (útil para pruebas internas).
# Genérala con:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
APP_PASSWORD=

# Firma la cookie de sesión. Si se deja vacía se genera una efímera en cada
# arranque, lo que cierra la sesión de todos en cada despliegue.
# Genérala con:  python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ── Datos personales ───────────────────────────────────────────────────
# Minutos que sobreviven los informes generados antes de borrarse solos.
# 0 = no purgar por tiempo (no recomendado en web).
RETENCION_MINUTOS=30

# Carpeta de resultados. En contenedor conviene un disco efímero (/tmp).
SALIDAS_DIR=

# Tamaño máximo del PDF cargado, en MB.
MAX_UPLOAD_MB=25

# ── HTTPS ──────────────────────────────────────────────────────────────
# Pon "0" si el servidor no tiene HTTPS (solo IP, sin dominio).
# Con HTTPS_ENABLED=0 las cookies no llevan Secure ni se envía HSTS.
# Cuando agregues un dominio con SSL, quita esta línea o pon "1".
HTTPS_ENABLED=1

# ── Servidor ───────────────────────────────────────────────────────────
PORT=5000
WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT=180
LOG_LEVEL=info

# Ruta del ejecutable de Chromium/Chrome (la imagen Docker ya la define).
# Solo hace falta si está en una ubicación no estándar.
CHROME_PATH=
